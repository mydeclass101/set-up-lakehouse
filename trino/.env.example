# คัดลอกเป็น .env เมื่อต้องการเปลี่ยนค่า (ไม่มี .env ก็ใช้ค่าด้านล่างนี้)
TRINO_PORT=8443
RUSTFS_ACCESS_KEY=student
RUSTFS_SECRET_KEY=classroom
SHOP_DB_USER=student
SHOP_DB_PASSWORD=student123
# TLS + ความลับภายในของ Trino (prod: secrets manager)
TRINO_KEYSTORE_PASSWORD=trino-keystore
TRINO_SHARED_SECRET=change-me-classroom-shared-secret
# ต้องตรงกับ ldap/.env
TRINO_BIND_PASSWORD=trino-bind
