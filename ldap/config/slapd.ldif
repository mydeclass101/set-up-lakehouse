# config ของ slapd (โหลดครั้งเดียวตอนเปิดครั้งแรก) · @@ROOT@@ ถูกแทนด้วย hash ของ LDAP_ROOT_PASSWORD
dn: cn=config
objectClass: olcGlobal
cn: config
olcPidFile: /run/openldap/slapd.pid

dn: cn=module,cn=config
objectClass: olcModuleList
cn: module
olcModulepath: /usr/lib/openldap
olcModuleload: back_mdb.so

dn: cn=schema,cn=config
objectClass: olcSchemaConfig
cn: schema

include: file:///etc/openldap/schema/core.ldif
include: file:///etc/openldap/schema/cosine.ldif
include: file:///etc/openldap/schema/inetorgperson.ldif

dn: olcDatabase=frontend,cn=config
objectClass: olcDatabaseConfig
objectClass: olcFrontendConfig
olcDatabase: frontend

# ฐานข้อมูลผู้ใช้ dc=dataplatform,dc=local
#   cn=root = ผู้ดูแล LDAP (แก้ได้ทุกอย่าง ใช้ตอนเพิ่ม / ลบผู้ใช้เท่านั้น)
#   สิทธิ์: รหัสผ่านอ่านไม่ได้ (ใช้ login ได้อย่างเดียว) · ผู้ใช้อ่านข้อมูลตัวเองได้ · บัญชี trino อ่านผู้ใช้ / กลุ่มได้ทั้งหมด
dn: olcDatabase=mdb,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: mdb
olcSuffix: dc=dataplatform,dc=local
olcRootDN: cn=root,dc=dataplatform,dc=local
olcRootPW: @@ROOT@@
olcDbDirectory: /var/lib/openldap/data
olcDbIndex: objectClass eq
olcDbIndex: uid eq
olcDbIndex: member eq
olcAccess: {0}to attrs=userPassword by self write by anonymous auth by * none
olcAccess: {1}to * by dn.exact="uid=trino,ou=services,dc=dataplatform,dc=local" read by self read by * none
